# Configuration pour application Vue.js
# Copiez ce fichier et renommez-le selon votre projet
# Exemple: dashboard.yml, frontend.yml, etc.

# ========================================
# INFORMATIONS DU PROJET
# ========================================
project:
  name: "vue-app"                    # Nom unique du projet
  description: "Application Vue.js"  # Description
  framework: "vuejs"                 # Framework utilisé
  version: "1.0.0"                   # Version du projet
  
# ========================================
# DÉPÔT GIT
# ========================================
repository:
  path: "/var/www/vue-app"           # Chemin absolu vers le projet
  branch: "main"                     # Branche à déployer
  git_url: "https://github.com/user/vue-app.git"  # URL du dépôt
  private_key_path: ""               # Chemin vers la clé SSH (optionnel)
  
# ========================================
# PROCESSUS PM2
# ========================================
process:
  name: "vue-app"                    # Nom du processus PM2 (doit être unique)
  instances: 1                       # Nombre d'instances
  exec_mode: "fork"                  # Mode d'exécution (fork/cluster)
  max_memory_restart: "500M"         # Redémarrage si mémoire > 500M
  watch: false                       # Surveillance des fichiers
  ignore_watch: ["node_modules", "logs"]
  
# ========================================
# SCRIPTS DE DÉPLOIEMENT
# ========================================
scripts:
  # Commande de build (optionnel - utilisez des pipes pour multiligne)
  build: |
    npm ci --only=production
    npm run build
  
  # Commande de démarrage PM2
  # Vue.js SPA - sert le dossier dist sur un port
  start: |
    pm2 serve dist 3000 --name vue-app --spa
  
  # Commandes pré/post déploiement (optionnel)
  pre_deploy: |
    echo "Préparation du déploiement Vue.js..."
    npm ci --only=production
  
  post_deploy: |
    echo "Déploiement Vue.js terminé"

# ========================================
# VARIABLES D'ENVIRONNEMENT
# ========================================
environment:
  NODE_ENV: "production"
  PORT: "3000"
  # Ajoutez vos variables ici
  # VUE_APP_API_URL: "https://api.votredomaine.com"
  # VUE_APP_VERSION: "1.0.0"

# ========================================
# NOTIFICATIONS
# ========================================
notifications:
  email: true           # Activer les notifications email
  slack: false          # Activer les notifications Slack
  webhook: ""           # Webhook personnalisé (optionnel)

# ========================================
# HEALTH CHECK
# ========================================
health_check:
  enabled: true
  url: "http://localhost:3000"  # URL à vérifier
  timeout: 30                   # Timeout en secondes
  retries: 3                    # Nombre de tentatives
  interval: 60                  # Intervalle en secondes

# ========================================
# MONITORING ET MÉTRIQUES
# ========================================
monitoring:
  enabled: true
  
  # Seuils d'alerte
  alerts:
    memory_threshold: 80        # Pourcentage mémoire
    cpu_threshold: 80           # Pourcentage CPU
    response_time_threshold: 3000  # Temps de réponse (ms)
    
  # Métriques à collecter
  metrics:
    - "memory_usage"
    - "cpu_usage"
    - "response_time"

# ========================================
# DÉPLOIEMENT CONDITIONNEL
# ========================================
deploy:
  # Conditions de déploiement (optionnel)
  conditions:
    - branch: "main"
      environment: "production"
    - branch: "develop"
      environment: "staging"
  
  # Déploiement automatique sur git push
  auto_deploy: true
  
  # Timeout du déploiement
  timeout: 300

# ========================================
# CONFIGURATION SPÉCIFIQUE VUE.JS
# ========================================
vuejs:
  # Type de build
  build_command: "npm run build"
  
  # Dossier de distribution
  dist_folder: "dist"
  
  # Mode SPA (Single Page Application)
  spa_mode: true
  
  # Configuration du serveur
  server:
    port: 3000
    host: "0.0.0.0"
    
  # Headers personnalisés
  headers:
    "Cache-Control": "public, max-age=31536000"
    "X-Content-Type-Options": "nosniff"

# ========================================
# MÉTADONNÉES
# ========================================
metadata:
  enabled: true               # Projet activé
  auto_start: true           # Démarrage automatique
  priority: 10               # Priorité (1-10)
  tags: ["frontend", "vuejs", "spa"]
  
  # Informations de contact
  owner: "dev-team@votredomaine.com"
  documentation_url: "https://docs.votredomaine.com/vue-app"
  
  # Horaires de maintenance (optionnel)
  maintenance_schedule: ""
  allowed_deploy_times: ["09:00-18:00"]  # Format: HH:MM-HH:MM