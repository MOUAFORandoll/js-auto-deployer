# Configuration générique pour projet JavaScript/TypeScript
# Template personnalisable pour tout type d'application

project:
  name: "mon-projet"
  description: "Mon projet personnalisé"
  framework: "generic"
  version: "1.0.0"

repository:
  path: "/var/www/mon-projet"
  branch: "main"
  git_url: "https://github.com/user/mon-projet.git"

process:
  name: "mon-projet"
  instances: 1
  exec_mode: "fork"
  max_memory_restart: "500M"
  watch: false
  ignore_watch: ["node_modules", "logs"]

scripts:
  # Commande de build (optionnel - mettez un build step si nécessaire)
  build: |
    # Exemples de build:
    # npm ci --only=production && npm run build
    # yarn install && yarn build
    # npm install && npm run build
    echo "Aucun build nécessaire pour ce projet"
  
  # Commande de démarrage PM2
  # Adaptez selon votre type d'application :
  start: |
    # Pour SPA (Vue, React, Angular - fichiers statiques)
    # pm2 serve dist 3000 --name mon-projet --spa
    
    # Pour API Node.js
    # PORT=3001 pm2 start dist/main.js --name mon-projet
    
    # Pour application avec serveur de développement
    # PORT=3002 pm2 start npm --name mon-projet -- start
    
    # Pour fichier spécifique
    # PORT=3003 pm2 start src/index.js --name mon-projet
    
    # Remplacez cette ligne par votre commande de démarrage réelle :
    echo "Configurez votre commande de démarrage dans scripts.start"
  
  # Scripts optionnels
  pre_deploy: |
    echo "Préparation du déploiement..."
    # Ajoutez vos commandes de pré-déploiement ici
  
  post_deploy: |
    echo "Déploiement terminé"
    # Ajoutez vos commandes de post-déploiement ici

environment:
  NODE_ENV: "production"
  PORT: "3000"
  # Ajoutez vos variables d'environnement ici
  # DATABASE_URL: "postgresql://..."
  # API_URL: "https://api.exemple.com"

notifications:
  email: true
  slack: false
  webhook: ""

health_check:
  enabled: true
  url: "http://localhost:3000"
  timeout: 30
  retries: 3
  interval: 60

monitoring:
  enabled: true
  alerts:
    memory_threshold: 80
    cpu_threshold: 80
    response_time_threshold: 3000
  metrics:
    - "memory_usage"
    - "cpu_usage"
    - "response_time"

deploy:
  auto_deploy: true
  timeout: 300

metadata:
  enabled: true
  auto_start: true
  priority: 10
  tags: ["custom", "javascript"]
  owner: "admin@votredomaine.com"