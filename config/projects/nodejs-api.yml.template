# Configuration pour API Node.js (Express, Fastify, etc.)

project:
  name: "nodejs-api"
  description: "API REST Node.js"
  framework: "nodejs"
  version: "1.0.0"

repository:
  path: "/var/www/nodejs-api"
  branch: "main"
  git_url: "https://github.com/user/nodejs-api.git"

process:
  name: "nodejs-api"
  instances: 1
  exec_mode: "fork"
  max_memory_restart: "1G"
  watch: false
  ignore_watch: ["node_modules", "logs", "*.log"]

scripts:
  build: |
    npm ci --only=production
    npm run build || echo "No build step"
  
  start: |
    PORT=3002 pm2 start dist/main.js --name nodejs-api
  
  pre_deploy: |
    echo "Préparation du déploiement API Node.js..."
    npm ci --only=production
  
  post_deploy: |
    echo "Déploiement API Node.js terminé"

environment:
  NODE_ENV: "production"
  PORT: "3002"
  # Ajoutez vos variables d'environnement API
  # DATABASE_URL: "postgresql://user:pass@localhost:5432/db"
  # JWT_SECRET: "your-secret-key"
  # API_VERSION: "v1"

notifications:
  email: true
  slack: false
  webhook: ""

health_check:
  enabled: true
  url: "http://localhost:3002/health"
  timeout: 30
  retries: 3
  interval: 60

monitoring:
  enabled: true
  alerts:
    memory_threshold: 85
    cpu_threshold: 80
    response_time_threshold: 5000
  metrics:
    - "memory_usage"
    - "cpu_usage"
    - "response_time"
    - "request_rate"
    - "error_rate"

deploy:
  auto_deploy: true
  timeout: 300

nodejs:
  # Type d'application
  app_type: "api"  # api, microservice, webapp
  
  # Commande de démarrage sans build
  start_direct: |
    PORT=3002 pm2 start src/index.js --name nodejs-api
  
  # Structure attendue
  structure:
    main_file: "src/index.js"    # Fichier principal
    dist_folder: "dist"          # Dossier de build (optionnel)
    config_file: ".env"          # Fichier de configuration
  
  # Variables PM2 spécifiques
  pm2_env:
    NODE_ENV: "production"
    PORT: "3002"
    
  # Monitoring spécifique Node.js
  monitoring:
    track_heaps: true
    track_handles: true

metadata:
  enabled: true
  auto_start: true
  priority: 9
  tags: ["backend", "nodejs", "api"]
  owner: "backend-team@votredomaine.com"